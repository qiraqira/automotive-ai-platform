# --- Identity (never hardcode these into application logic) ---
PROJECT_NAME=PROJECT_NAME
PUBLIC_DOMAIN=DOMAIN.COM
PUBLIC_URL=https://DOMAIN.COM

NODE_ENV=development

# --- Database ---
DATABASE_URL=postgresql://automotive:CHANGE_ME@localhost:5432/automotive_platform

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible: AWS S3, MinIO, Backblaze, Timeweb S3, etc.) ---
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=automotive-platform-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# --- Auth ---
AUTH_JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
AUTH_COOKIE_NAME=automotive_session

# --- AI providers (abstracted behind packages/ai — add only what you actually use) ---
AI_DEFAULT_TEXT_PROVIDER=anthropic
AI_DEFAULT_EMBEDDING_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- AI budget guardrails (see docs/ai-pipeline.md) ---
AI_DAILY_BUDGET_USD=20
AI_MONTHLY_BUDGET_USD=400
AI_PER_TASK_MAX_USD=2

# --- Feature flags (all default OFF until proven safe - see docs/editorial-system.md #75) ---
AUTO_CLUSTER=false
AUTO_RESEARCH=false
AUTO_DRAFT=false
AUTO_PUBLISH=false
AUTO_MODERATION=false
AUTO_SEO=false
AI_KILL_SWITCH=false

# --- Quality gate thresholds (only used when AUTO_MODERATION=true) ---
# overall weighted score >= this -> publish; >= reviewAt but below this -> review; below reviewAt -> reject.
# See packages/editorial/src/quality-gate.ts for the exact weighting/hard-floor rules.
QUALITY_GATE_PUBLISH_AT=70
QUALITY_GATE_REVIEW_AT=50

# --- Ports (local dev) ---
API_PORT=4000
WEB_PORT=3000
