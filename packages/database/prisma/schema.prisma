enum ArticleImageRole {
  HERO
  INLINE
  GALLERY
  OG
}

model ArticleImage {
  id        String           @id @default(cuid())
  articleId String
  article   Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  imageId   String
