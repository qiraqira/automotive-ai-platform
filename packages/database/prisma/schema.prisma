  height           Int?
  mimeType         String?
  sha256           String            @unique
  perceptualHash   String?
  generatedByAi    Boolean           @default(false)
  c2paMetadata     Json?
  createdAt        DateTime          @default(now())

  articleImages ArticleImage[]
  carModelImages CarModelImage[]
  brandLogos     Brand[]

  @@index([perceptualHash])
  @@map("images")
}

model ImageLicense {
  id                   String   @id @default(cuid())
  provider             String
  licenseType          String
  licenseUrl           String?
  attributionRequired  Boolean  @default(true)
  commercialUseAllowed Boolean  @default(false)
  modificationAllowed  Boolean  @default(false)
  expiresAt            DateTime?
  notes                String?
  verifiedBy           String?
  verifiedAt           DateTime?
  images               Image[]

  @@map("image_licenses")
