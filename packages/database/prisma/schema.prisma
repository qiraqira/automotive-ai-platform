// ============================================================================
// 10. AI ORCHESTRATION  (spec §39-§47, extension §72-§74)
// ============================================================================

enum AIJobType {
  DISCOVER_SOURCES
  CLUSTER_STORY
  RESEARCH_STORY
  EXTRACT_FACTS
  FACT_CHECK
  WRITE_ARTICLE
  QUALITY_CHECK
  MODERATE_COMMENT
  SEO_AUDIT
  UPDATE_STALE_CONTENT
}

enum AIJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
  CANCELLED
}

model AIJob {
  id          String      @id @default(cuid())
  type        AIJobType
  status      AIJobStatus @default(PENDING)
  priority    Int         @default(50)
  storyId     String?
  story       Story?      @relation(fields: [storyId], references: [id])
  input       Json
  result      Json?
  attempts    Int         @default(0)
  maxAttempts Int         @default(3)
  deadline    DateTime?
  createdAt   DateTime    @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  executions AIExecution[]

  @@index([status, priority])
  @@map("ai_jobs")
}

// One row per actual model call within a job (spec §45 cost accounting,
// §72 reproducibility).
model AIExecution {
  id               String   @id @default(cuid())
  jobId            String
  job              AIJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider         String
  model            String
  promptTemplateId String?
  promptTemplate   PromptTemplate? @relation(fields: [promptTemplateId], references: [id])
  promptVersion    Int?
  tokensIn         Int      @default(0)
  tokensOut        Int      @default(0)
  estimatedCostUsd Float    @default(0)
  latencyMs        Int?
  success          Boolean
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@map("ai_executions")
}

enum AutonomyLevel {
  SAFE
  CONTROLLED
  HIGH_RISK
}

// Every autonomous action the agent takes, independent of whether it came
// from an AIJob (spec §42 "AI Action Log").
//
// Forward-looking note added 2026-09-08 (checked during a fresh review —
// this table has zero real callers yet, matches the AI pipeline's own
// still-0%-built status): `entityType`/`entityId` below are a polymorphic
// edge, structurally identical to `EntityRelation.fromType`/`fromId` —
// and that exact pattern already caused a real bug earlier in this
// project (raw string literals at every write site, no compile-time
// typo protection, fixed by switching every real writer to
// `packages/types`' `ENTITY_TYPE` const object instead of bare strings).
// When this table gets its first real writer, use `ENTITY_TYPE` here too
// rather than repeating that same mistake — the DB column stays a plain
// `String` either way (Prisma has no native polymorphic-relation type),
// the fix is entirely at the application call-site level.
model AIAgentAction {
  id              String        @id @default(cuid())
  action          String
  autonomyLevel   AutonomyLevel
  entityType      String
  entityId        String
  reason          String
  input           Json?
  output          Json?
  confidence      Float?
  approvedByUserId String?
  result          String // "applied" | "queued_for_review" | "rejected"
  createdAt       DateTime      @default(now())

  @@index([entityType, entityId])
  @@map("ai_agent_actions")
}

model PromptTemplate {
  id       String          @id @default(cuid())
  key      String          @unique // "article_writer", "fact_checker", "story_clusterer", ...
  versions PromptVersion[]
  executions AIExecution[]

  @@map("prompt_templates")
}

// Forward-looking note added 2026-09-08 (checked during a fresh review —
// zero real rows/callers exist yet): docs/ai-pipeline.md describes this
// as "one isActive at a time" per template, but nothing at the DB level
// enforces that — `@@unique([promptTemplateId, version])` only prevents
// two rows sharing the same version number, not two rows both having
// `isActive: true` for the same template. Prisma's schema DSL has no
// native partial-unique-index syntax for this (would need a raw-SQL
// migration, e.g. `CREATE UNIQUE INDEX ... WHERE "isActive"`, the same
// kind of extension this project's `pg_trgm` index already needed —
// see docs/database.md's "non-obvious decision" #6 for that precedent).
// Whoever builds the real prompt-versioning write path should either
// add that migration or enforce "exactly one active version" in
// application code (e.g. a transaction that deactivates the previous
// active version before activating a new one) — currently neither
// exists, so nothing would catch two simultaneously-active versions.
model PromptVersion {
  id               String         @id @default(cuid())
  promptTemplateId String
  promptTemplate   PromptTemplate @relation(fields: [promptTemplateId], references: [id])
  version          Int
  body             String
  isActive         Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@unique([promptTemplateId, version])
  @@map("prompt_versions")
}

