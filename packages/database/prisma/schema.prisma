enum ImageSourceType {
  OFFICIAL_PRESS
  LICENSED_STOCK
  OWN_PHOTO
  USER_LICENSED
  PUBLIC_DOMAIN
  CREATIVE_COMMONS
  AI_GENERATED
  EMBED_ONLY
  UNKNOWN
}

enum ImageRightsStatus {
  VERIFIED_LICENSE
  OFFICIAL_USE_ALLOWED
  LICENSE_REQUIRED
  PUBLIC_DOMAIN
  CC_BY
  CC_BY_SA
  EDITORIAL_ONLY
  EMBED_ONLY
  UNKNOWN
  BLOCKED
}

model Image {
  id               String            @id @default(cuid())
  originalUrl      String
  localStorageUrl  String?
  sourceType       ImageSourceType
  rightsStatus     ImageRightsStatus @default(UNKNOWN)
  author           String?
  copyright        String?
  attribution      String?
  licenseId        String?
  license          ImageLicense?     @relation(fields: [licenseId], references: [id])
