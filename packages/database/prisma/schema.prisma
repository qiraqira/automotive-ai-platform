// ============================================================================
// 13. SEARCH, ANALYTICS, OPERATIONS  (spec §32, §49, §55-§56)
// ============================================================================

model SearchQuery {
  id        String   @id @default(cuid())
  query     String
  locale    Locale
  resultsCount Int
  createdAt DateTime @default(now())

  // Real gap found and fixed 2026-09-08: GET /v1/search-queries orders
  // every real query by `createdAt: "desc"` for its own real offset-
  // pagination — this table had no index backing that sort at all. Of
  // this project's 4 paginated-by-timestamp tables, this is the most
  // urgent instance: this dev DB already has 722+ real logged
  // SearchQuery rows (per this project's own earlier pagination fix),
  // not a hypothetical future concern.
  @@index([createdAt])
  @@map("search_queries")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  type       String // "pageview" | "scroll" | "click" | ...
  articleId  String?
  path       String
  sessionId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@map("analytics_events")
}

enum SystemAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model SystemAlert {
  id         String              @id @default(cuid())
  severity   SystemAlertSeverity
  source     String // "crawler" | "ai" | "database" | "publisher" | ...
  message    String
  metadata   Json?
  resolved   Boolean             @default(false)
  createdAt  DateTime            @default(now())
  resolvedAt DateTime?

  // Real gap found and fixed 2026-09-08: GET /v1/alerts orders every
  // real query by `createdAt: "desc"` for its own real offset-
  // pagination, same as SearchQuery/Story above — this table had an
  // index for filtering (`resolved, severity`) but nothing backing the
  // actual sort column.
  @@index([createdAt])
  @@index([resolved, severity])
  @@map("system_alerts")
}
